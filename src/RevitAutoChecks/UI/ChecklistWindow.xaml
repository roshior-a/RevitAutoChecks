<Window x:Class="RevitAutoChecks.UI.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RevitAutoChecks.UI"
        Title="{Binding WindowTitle}"
        Width="1100" Height="680" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="PassedBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="FailedBrush" Color="#C62828" />
        <SolidColorBrush x:Key="NotRunBrush" Color="#757575" />
        <SolidColorBrush x:Key="OutdatedBrush" Color="#EF6C00" />
        <SolidColorBrush x:Key="MutedBrush" Color="#616161" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="BorderBrushLight" Color="#DDDFE3" />

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource NotRunBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Passed">
                    <Setter Property="Foreground" Value="{StaticResource PassedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource FailedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActualityTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OutdatedBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{StaticResource NotRunBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Passed">
                    <Setter Property="Fill" Value="{StaticResource PassedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Fill" Value="{StaticResource FailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource OutdatedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,3,16,3" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Свод по проверкам -->
        <DataTemplate DataType="{x:Type ui:ChecklistViewModel}">
            <DockPanel Margin="20,16">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Margin="0" VerticalAlignment="Top"
                            Content="Обновить все" Command="{Binding RunAllCommand}" />
                    <StackPanel>
                        <TextBlock Text="Свод по проверкам" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ModelTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding OverviewText}" Margin="0,14,0,4" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding FreshnessHint}" Margin="0,0,0,10"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />

                <ListView ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck}"
                          BorderBrush="{StaticResource BorderBrushLight}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="№" Width="40" DisplayMemberBinding="{Binding Number}" />
                            <GridViewColumn Header="Проверка" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Статус" Width="115">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Актуальность" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActualityText}" Style="{StaticResource ActualityTextStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Выполнена" Width="115" DisplayMemberBinding="{Binding RunAtText}" />
                            <GridViewColumn Header="Кем" Width="100" DisplayMemberBinding="{Binding RunBy}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </DataTemplate>

        <!-- Отдельная проверка -->
        <DataTemplate DataType="{x:Type ui:CheckItemViewModel}">
            <Grid Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Foreground="{StaticResource MutedBrush}">
                        <Run Text="Проверка №" /><Run Text="{Binding Number, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Статус" Style="{StaticResource LabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Margin="0,3">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}" />
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Text="Актуальность" Style="{StaticResource LabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActualityText}" Margin="0,3"
                               Style="{StaticResource ActualityTextStyle}" />
                    <TextBlock Grid.Row="2" Text="Выполнена" Style="{StaticResource LabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}">
                        <Run Text="{Binding RunAtText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RunBy, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="3" Text="Результат" Style="{StaticResource LabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource ValueStyle}" />
                </Grid>

                <WrapPanel Grid.Row="2" Margin="0,16,0,12">
                    <Button Content="Обновить" Command="{Binding RunCommand}" />
                    <Button Content="Выделить элементы" Command="{Binding SelectCommand}" />
                    <Button Content="{Binding LogButtonText}" Command="{Binding ToggleLogCommand}" />
                </WrapPanel>

                <DockPanel Grid.Row="3" Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Top" Text="Лог проверки" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}"
                             Padding="6" />
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <!-- Список проверок -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,1,0">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Top" Margin="10,12,10,6" Padding="10,7"
                              HorizontalContentAlignment="Left"
                              Content="Свод по проверкам"
                              Command="{Binding ShowSummaryCommand}"
                              IsChecked="{Binding IsSummaryPage, Mode=OneWay}" />
                <TextBlock DockPanel.Dock="Top" Text="ПРОВЕРКИ" Margin="14,8,10,4" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" />
                <ListBox ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck}"
                         Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,4,8,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                    <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Свод или выбранная проверка -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

        <!-- Индикатор выполнения -->
        <Border Grid.ColumnSpan="2" Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16"
                    Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="{Binding BusyText}" FontSize="14" />
            </Border>
        </Border>
    </Grid>
</Window>
